# --- Secrets: NEVER commit these ---
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# --- Private vault content (user data that must stay local) ---
vault/private/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Tooling / OS ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db

# --- Editors ---
.idea/
.vscode/
*.swp

# Obsidian per-user state (keep app/graph settings, ignore volatile workspace)
vault/**/.obsidian/workspace.json
